{
  "name": "@navale/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.cjs",
    "typecheck": "tsc -p tsconfig.json",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/main.cjs --log-level=warning"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@navale/engine": "workspace:*",
    "@navale/protocol": "workspace:*",
    "fastify": "^5.3.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "esbuild": "^0.28.2",
    "socket.io-client": "^4.8.0",
    "tsx": "^4.19.0"
  }
}
