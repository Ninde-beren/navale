# URL publique vue par les téléphones (QR code, liens). Obligatoire.
PUBLIC_URL=https://navale.sigilbo.fr
# Réseau Docker externe du reverse proxy (Caddy d'infra-docker).
WEB_NETWORK=web
# Port local exposé hors Docker, et interface d'écoute.
NAVALE_PORT=5251
BIND=127.0.0.1
# info en exploitation courante, debug pour chercher un problème.
LOG_LEVEL=info
# Espace d'administration https://…/admin (HTTP Basic Auth). Sans mot de passe, il reste fermé.
# Mot de passe long et aléatoire : openssl rand -base64 24
ADMIN_USER=admin
ADMIN_PASSWORD=
# Retours du bouton « Un avis ? » : enregistrés en base et listés dans /admin ; envoyés
# par mail dès que ces deux lignes sont remplies. SMTP_URL : smtps://utilisateur:motdepasse@hote:465
# (TLS direct) ou smtp://utilisateur:motdepasse@hote:587 (STARTTLS). Mot de passe avec des
# caractères spéciaux : les encoder (%40 pour @). MAIL_FROM facultatif, par défaut FEEDBACK_TO.
FEEDBACK_TO=
MAIL_FROM=
# Transport : Mailjet (les clés du compte, celles du service de mail de Tutotou), sinon SMTP_URL.
# Avec Mailjet, MAIL_FROM doit être une adresse ou un domaine validé dans le compte.
MAILJET_API_KEY=
MAILJET_API_SECRET=
SMTP_URL=
